{
  "name": "@cambrian/design-system",
  "version": "0.1.1",
  "description": "Cambrian's design system for dashboards and data terminals: tokens, a base layer and React components.",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./core.css": "./src/core.css",
    "./fonts.css": "./src/fonts.css",
    "./theme": "./src/theme.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "vite showcase",
    "build": "vite build showcase",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run test:unit && npm run typecheck && npm run lint && npm run build && npm run test:visual",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:unit": "node --test tests/unit/*.test.mjs"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.7.0",
    "lucide-react": ">=1.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@eslint/js": "^9",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "lucide-react": "1.31.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^5",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
